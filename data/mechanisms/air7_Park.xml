<!--
Park air7 reaction mechanism: 7-species ionized air subset of air11_Park
(e-, N, O, NO, N2, O2, NO+).  Rates taken verbatim from air11_Park.xml:
    1) Park et al., JTHT 15(1):76-90, 2001.
    2) Park, JTHT 7(3):385-398, 1993.
Reactions involving N+, O+, N2+, O2+ (charge exchange, electron-impact
ionization to those ions) are excluded: those ions are not part of the
air_7 composition.
-->
<mechanism name="air7_Park">

    <arrhenius_units A="mol,cm,s,K" E="kcal,mol,K" />

<reaction formula="N2+M=2N+M">
        <arrhenius A="7.0E+21" n="-1.6" T="113200.0" />
        <M>O:4.285714285714286, N:4.285714285714286</M>
    </reaction>

    <reaction formula="N2+e-=2N+e-">
        <arrhenius A="3.0E+24" n="-1.6" T="113200." />
    </reaction>

    <reaction formula="O2+M=2O+M">
        <arrhenius A="2.0E+21" n="-1.5" T="59360.0" />
        <M>O:5.0, N:5.0</M>
    </reaction>

    <reaction formula="NO+M=N+O+M">
        <arrhenius A="5.0E15" n="0.0" T="75500.0" />
        <M>NO:22.0, N:22.0, O:22.0</M>
    </reaction>

    <reaction formula="N2+O=NO+N">
        <arrhenius A="5.7E+12" n="0.42" T="42938.0" />
    </reaction>

    <reaction formula="NO+O=O2+N">
        <arrhenius A="8.4E+12" n="0.0" T="19400.0" />
    </reaction>

    <reaction formula="N+O=NO++e-">
        <arrhenius A="5.3E+12" n="0.00" T="31900.0" />
    </reaction>

</mechanism>
