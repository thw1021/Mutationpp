<!--
  Single gamma-model catalytic reaction for the local n2_2 (N2/N) mixture.
  Gamma value 0.01 matches the COOLFluiD Catalicity testcase (Gamma_N).
  Used by the NoSlipWallIsothermalNSrvtGSI boundary condition validation.
-->
<gsi gsi_mechanism = "phenomenological_mass">

    <surface_properties type = "none" >
    </surface_properties>

    <surface_chemistry>
        <reaction type= "catalysis" formula="N + N => N2">
            <gamma_const> N:.01 </gamma_const>
        </reaction>
    </surface_chemistry>

</gsi>
